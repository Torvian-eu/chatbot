{
  /*
    Worker application.json (template)
    - Copy/edit this into config/application.json.
    - Keep non-secret runtime defaults here.
    - Secrets stay in secrets.json, generated by --setup.
  */

  "worker": {
    "server": {
      "baseUrl": "http://localhost:8080/"
    },
    "identity": {
      "uid": "",
      "displayName": "my-worker",
      "workerId": null,
      "certificateFingerprint": "",
      "certificatePem": ""
    },
    "storage": {
      "secretsJsonPath": "./secrets.json",
      "tokenFilePath": "./token.json"
    },
    "auth": {
      "refreshSkewSeconds": 60
    },
    "workspace": {
      "path": "../workspace"
    },
    "builtInTools": {
      "enabled": ["*"],
      "defaultCommandTimeoutSeconds": 600
    },
    /*
      Command isolation for built-in tools (Linux only). Processes spawned by `run_command` run
      as a different, unprivileged OS account ("agent") so that ordinary file permissions keep the
      worker's secrets out of reach.

      It ships disabled, because the mechanism needs a root-owned setuid helper and a separate
      account: enabling it where neither exists makes the worker refuse to start. Where both exist -
      the shipped image installs them - set "enabled": true in the block below, or start the worker
      with WORKER_COMMAND_ISOLATION_ENABLED=true. While it is disabled, commands run as the worker's
      account and the startup log states that.

      The remaining keys are optional and the values below are the effective defaults once the switch
      is on:

        "commandIsolation": {
          "enabled": true,
          "user": "agent",
          "helperPath": "/usr/local/bin/run-as-agent",
          "environment": {
            "allowPassthrough": ["PATH", "LANG", "LC_ALL"],
            "set": {
              "GIT_CONFIG_COUNT": "1",
              "GIT_CONFIG_KEY_0": "safe.directory",
              "GIT_CONFIG_VALUE_0": "*"
            }
          }
        }

      "enabled": true makes the worker refuse to start when the privilege-dropping helper is
      missing or cannot drop, instead of silently running commands with the worker's privileges.
      Set it to false to accept that risk deliberately: the worker then logs a warning and commands
      run as the worker's account. On platforms without the mechanism the setting is ignored and a
      single informational line is logged.

      "user" and "helperPath" name the account commands run as and the helper binary that performs
      the drop. "environment.allowPassthrough" lists worker environment variables that isolated
      children receive; a single "*" forwards everything. "environment.set" carries variables the
      child receives with the values given here, whether or not the worker defines them. Both are used
      only while the privilege drop is active, and the account identity variables (HOME, USER,
      LOGNAME) always come from the isolated account, so a "set" entry naming one of them has no
      effect. Add the variables your commands need, for example proxy settings or cache roots such as
      GOPATH, GOCACHE, GRADLE_USER_HOME, NPM_CONFIG_CACHE, UV_CACHE_DIR.

      The default "set" exempts the shared workspace from git's repository-ownership check, because
      the workspace is owned by the worker account while commands run as the isolated one: git reads
      GIT_CONFIG_COUNT and the matching GIT_CONFIG_KEY_0/GIT_CONFIG_VALUE_0 entry as configuration
      (git 2.31 or newer). The exemption reaches isolated commands only, because the values are read
      from this file rather than from the worker's process environment, so a git the worker itself
      runs keeps refusing repositories in the workspace; that is what stops a repository planted
      there from executing code as the worker. Replace or remove this block to decide otherwise, or
      set the exemption in the isolated account's own global config (/home/agent/.gitconfig)
      instead. An empty "set" ("{}") removes the default entries rather than adding to them.
      Neither key is reachable through env-mapping.json, which maps a single setting to the name of
      an environment variable.
    */
    "commandIsolation": {
      "enabled": false
    },
    /*
      Interactive terminal sessions for the `terminal_session` built-in tool. Sessions run as the
      same account as `run_command` children and are terminated when the worker shuts down. There is
      deliberately no worker-side enable flag: the capability is controlled by enabling or disabling
      the tool for a user on the server, and by whether this worker image contains it. A call that
      reaches the worker executes.

      Memory is bounded per session and for the closed-session archive: at most `maxSessions` live
      sessions, and at most `maxClosedSessions` tombstones of `maxOutputBytesPerSession` each (about
      8 MiB with the defaults). `closedSessionRetentionSeconds` additionally bounds how long a closed
      session stays inspectable. `reaperIntervalSeconds` must be smaller than
      `defaultIdleTimeoutSeconds`, so a session is never reaped before it has been idle for at least
      one full sweep.

      Secrets are not supported in v1: an interactive `ssh` must use keys or an already-authenticated
      agent. Under command isolation the child is the isolated account and carries PR_SET_NO_NEW_PRIVS,
      so `sudo`, `su` and `passwd` cannot elevate inside a session.
    */
    "terminalSessions": {
      "defaultIdleTimeoutSeconds": 1800,
      "maxIdleTimeoutSeconds": 28800,
      "maxLifetimeSeconds": 86400,
      "maxSessions": 8,
      "maxClosedSessions": 32,
      "maxOutputBytesPerSession": 262144,
      "quietMillis": 300,
      "defaultWaitMillis": 5000,
      "maxWaitMillis": 30000,
      "reaperIntervalSeconds": 30,
      "closedSessionRetentionSeconds": 3600,
      "columns": 120,
      "rows": 40,
      "tuiEscapeRatioThreshold": 0.15
    },
    "trustedSigners": []
  }
}

