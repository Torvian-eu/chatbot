{
  /*
    Production/application.json (template)
    - Copy/edit this into config/application.json on the worker.
    - Do NOT place secrets (passwords, keys) here; put them in config/secrets.json or provide via environment vars.
    - This template intentionally omits sensitive values so the loader will require them from secrets.json or env.
    - The data directory (token cache) is always a sibling of the config directory.
  */

  "worker": {
    "server": {
      "baseUrl": "http://localhost:8080"
    },
    "identity": {
      "uid": "",
      "displayName": "my-worker",
      "certificateFingerprint": "",
      "certificatePem": ""
    },
    "storage": {
      "secretsJsonPath": "./secrets.json",
      "tokenFilePath": "./token.json"
    },
    "auth": {
      "refreshSkewSeconds": 300
    },
    /*
      Filesystem workspace for built-in tools. All file paths in built-in tool calls are
      resolved against this directory and rejected if they escape it. The directory is
      created at startup if it does not exist.
    */
    "workspace": {
      "path": "../workspace"
    },
    /*
      Built-in tool enablement. `enabled` lists the unprefixed names of tools that are
      available; a single "*" enables all registered tools. Tool-name prefixing is a
      server-side catalog concern and is not applied at the worker runtime.
    */
    "builtInTools": {
      "enabled": ["*"],
      "defaultCommandTimeoutSeconds": 600
    },
    "trustedSigners": [
      {
        "signerId": "uuid-of-signer-1", // app device id
        "publicKeyBase64": "base64-encoded-public-key-of-signer-1", // app device public key in base64
        "permissions": [
          "permission-1-for-signer-1",
          "permission-2-for-signer-1"
        ]
      }
    ]
  }
}
